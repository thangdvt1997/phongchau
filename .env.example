# Copy to .env and fill in real values before deploying. Never commit the real .env.

# --- Postgres ---
POSTGRES_USER=phongchau
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phongchau
DATABASE_URL=postgresql://phongchau:change-me@postgres:5432/phongchau?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Backend ---
NODE_ENV=production
BACKEND_PORT=4000
UPLOAD_DIR=/app/uploads
PUBLIC_BASE_URL=http://37.49.225.142:8730

# Host-side port mappings for the DEV compose stack (docker-compose.yml) only — pick free
# ports on shared hosts. PROD compose only exposes nginx on NGINX_HTTP_PORT below.
BACKEND_HOST_PORT=8710
FRONTEND_HOST_PORT=8711
ADMINER_HOST_PORT=8712

# --- Frontend ---
NEXT_PUBLIC_SITE_URL=http://37.49.225.142:8730
NEXT_PUBLIC_API_BASE_URL=http://37.49.225.142:8730/api/v1
# Used only by Next.js server components, inside the Docker network — not the public URL.
INTERNAL_API_BASE_URL=http://backend:4000/api/v1
FRONTEND_PORT=3000

# --- Analytics (spec section 34; all optional — each script/pixel no-ops until its ID is set) ---
# GA4 Measurement ID, e.g. G-XXXXXXXXXX. Leave empty to skip loading gtag.js entirely.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Google Tag Manager container ID, e.g. GTM-XXXXXXX. Leave empty to skip loading GTM entirely.
NEXT_PUBLIC_GTM_CONTAINER_ID=
# Meta (Facebook) Pixel ID. Leave empty to skip loading the Meta Pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=
# TikTok Pixel ID. Leave empty to skip loading the TikTok Pixel entirely.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- SMTP (leave EMAIL_ENABLED=false to no-op notifications in test env) ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Phong Chau <no-reply@phongchau.example>"

# --- Payment providers (disabled stubs; enable when real sandbox keys exist) ---
PAYMENT_VNPAY_ENABLED=false
PAYMENT_VNPAY_TMN_CODE=
PAYMENT_VNPAY_HASH_SECRET=
PAYMENT_STRIPE_ENABLED=false
PAYMENT_STRIPE_SECRET_KEY=

# --- Search (OpenSearch; falls back to Postgres search automatically if unavailable) ---
OPENSEARCH_ENABLED=true
OPENSEARCH_NODE=http://opensearch:9200

# --- VietQR (bank transfer via QR — no API key needed) ---
# On by default: no gateway account required, just the bank account below. Set to false to
# hide it (e.g. if the account changes and isn't ready yet).
PAYMENT_VIETQR_ENABLED=true
# TPBank's VietQR bank BIN. See https://api.vietqr.io/v2/banks for other banks' BINs.
VIETQR_BANK_BIN=970423
VIETQR_ACCOUNT_NO=01294064001
# Uppercase, no Vietnamese diacritics — the VietQR display convention. Should match the real
# registered TPBank account holder name for the QR to look verified in banking apps; a
# mismatch here doesn't break the transfer itself (routing uses the BIN + account number).
VIETQR_ACCOUNT_NAME="PHONG CHAU AGRI FOOD"
# NEXT_PUBLIC_ copies: the frontend builds the QR image URL client-side (img.vietqr.io), and
# Next.js only exposes NEXT_PUBLIC_* vars to the browser bundle.
NEXT_PUBLIC_VIETQR_BANK_BIN=970423
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=01294064001
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME="PHONG CHAU AGRI FOOD"

# --- Nginx exposed port on host ---
NGINX_HTTP_PORT=8730
